#!/bin/bash
# Pre-commit hook：提交前骨架文件一致性校验
# 安装方式: cp scripts/pre-commit.sample .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# 说明：本 hook 校验的是「进 git 的骨架文件」（主指令 / skills / templates / opencode.json），
#       用于阻断多文件同步漂移。document/ 已由 .gitignore 忽略（属用户自有产物），
#       其需求包完整性请用 scripts/validate-docs.sh 手动/CI 校验，不在本 hook 范围。

set -e

COLOR_BLUE="\033[0;34m"
COLOR_GREEN="\033[0;32m"
COLOR_RED="\033[0;31m"
COLOR_RESET="\033[0m"

echo -e "${COLOR_BLUE}🔍 Pre-commit: 骨架文件一致性校验...${COLOR_RESET}"

# 定位仓库根目录
root="$(git rev-parse --show-toplevel)"

# 运行全仓一致性校验（失败则阻塞提交）
if "$root/scripts/consistency-check.sh"; then
    echo -e "${COLOR_GREEN}✅ 一致性校验通过，允许提交${COLOR_RESET}"
    exit 0
else
    echo -e "${COLOR_RED}❌ 一致性校验失败，阻止提交${COLOR_RESET}"
    echo ""
    echo "💡 可选操作:"
    echo "   1. 修复上述不一致后重新提交"
    echo "   2. 如需临时跳过校验: git commit --no-verify"
    exit 1
fi
